# Copy to .env.local and fill in real values. Never commit .env.local.
# See docs/01-ARCHITECTURE.md §9 for the full description of each variable.

# --- Supabase (required) ---------------------------------------------------
# Project URL and anon key from `supabase status` locally, or the project settings in the
# Supabase dashboard. The anon key is safe to expose; RLS protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Service role key. Server-only, used by Edge Functions and admin scripts. Never expose to
# the client bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Application (required) -------------------------------------------------
# Absolute URL of this deployment. Used for OAuth redirects, emails, and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI assistant (optional; unset disables the assistant) ------------------
# AI_PROVIDER=openai
# AI_MODEL=gpt-5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Foreign exchange (optional; defaults to the free Frankfurter endpoint) -
# FX_API_URL=https://api.frankfurter.app

# --- Web push (optional; generate with `pnpm push:keys`) --------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Bank sync (optional) ----------------------------------------------------
# BANK_PROVIDER=enablebanking
# BANK_APP_ID=
# BANK_PRIVATE_KEY=

# --- Transactional email (optional; falls back to Supabase's built-in SMTP) -
# RESEND_API_KEY=

# --- Error reporting (optional; disabled unless set) -------------------------
# SENTRY_DSN=

# --- Scheduled jobs (required in production) ---------------------------------
# Shared secret asserted by every Edge Function entry point that pg_cron calls.
# CRON_SECRET=
