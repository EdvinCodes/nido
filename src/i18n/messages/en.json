    "problem": {
      "title": "The spreadsheet is not enough",
      "subtitle": "When money is shared, you need one place everyone trusts.",
      "cards": {
        "spreadsheet": {
          "title": "Spreadsheets break down",
          "body": "Broken formulas, conflicting copies, and no one knows the real total."
        },
        "whoPaid": {
          "title": "Who paid for what?",
          "body": "Arguments start when splits are unclear or impossible to verify."
        },
        "subscription": {
          "title": "Forgotten subscriptions",
          "body": "Small recurring charges that pile up because nobody reviews them."
        }
      }
    },
    "features": {
      "title": "Built for everyday life",
      "items": {
        "splits": {
          "title": "Exact splits",
          "body": "Five split modes. Cents always add up — the database enforces it."
        },
        "ledger": {
          "title": "Instant ledger",
          "body": "Every expense, income, and transfer in a fast, filterable shared list."
        },
        "budgets": {
          "title": "Budgets with alerts",
          "body": "Category limits and warnings before you overspend, in your home currency."
        },
        "balances": {
          "title": "Balances between people",
          "body": "Who owes whom, simplified. No informal running tabs."
        }
      }
    },
    "modes": {
      "title": "One app, three ways to live",
      "subtitle": "The same core adapts to your household.",
      "items": {
        "solo": {
          "label": "Solo",
          "title": "Personal finance",
          "body": "Accounts, categories, and goals without split complexity."
        },
        "couple": {
          "label": "Couple",
          "title": "Two people, one nest",
          "body": "Shared and personal spending with fair splits by default."
        },
        "flatshare": {
          "label": "Flatshare",
          "title": "Several roommates",
          "body": "Participants, weights, and balances so no one keeps score by hand."
        }
      }
    },
    "privacy": {
      "title": "Your data stays yours",
      "body": "Self-host on Supabase, no trackers or ads. Open source so you can verify."
    },
    "openSource": {
      "title": "Open and auditable",
      "body": "Next.js, Supabase, and strict TypeScript. Clone it, deploy it, make it yours.",
      "stack": {
        "next": "Next.js 16",
        "supabase": "Supabase",
        "tailwind": "Tailwind v4"
      },
      "snippet": "git clone github.com/EdvinCodes/nido\ncd nido && pnpm install\npnpm db:start && pnpm db:reset\npnpm dev"
